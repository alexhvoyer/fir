    "Turn on Zen Workspaces under Sync to see and edit them here." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Пространства Zen» в разделе «Синхронизация», чтобы видеть и изменять их здесь."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
