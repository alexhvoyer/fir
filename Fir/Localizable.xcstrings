    " — %@" : {
      "shouldTranslate" : false
    },
    "\"%@\" will be able to read and change %@ and %lld more." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@\" will be able to read and change %2$@ and %3$lld more."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» сможет читать и изменять %2$@ и ещё %3$lld."
          }
        }
      }
    },
    "\"%@\" will be able to read and change %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
