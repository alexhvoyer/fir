    "Adds protection against malicious websites. Heavy sites run slower in private tabs. Applies from the next page load." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет защиту от вредоносных сайтов. Тяжёлые сайты в частных вкладках работают медленнее. Действует со следующей загрузки страницы."
          }
        }
      }
    },
    "Ads and trackers load on every site." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реклама и трекеры загружаются на всех сайтах."
          }
        }
      }
    },
    "Ads on English-language and international sites" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реклама на англоязычных и международных сайтах"
          }
        }
      }
    },
    "Already in Your Language" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже на вашем языке"
          }
        }
      }
    },
    "Always Use Reader" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всегда в режиме чтения"
          }
        }
      }
    },
    "Always connects securely, and asks before opening a site that doesn't support it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всегда подключается по защищённому соединению и спрашивает, прежде чем открыть сайт, который его не поддерживает."
          }
        }
      }
    },
    "An open-source iPhone browser. Your Zen or Firefox tabs come along." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Браузер для iPhone с открытым кодом. Вкладки из Zen или Firefox — с вами."
          }
        }
      }
    },
    "Annoyances are newsletter and open-in-app pop-ups, chat and notification prompts, and social buttons. To turn blocking off for one site, use the page menu." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раздражители — это окна подписок и предложения открыть приложение, чаты, запросы уведомлений и кнопки соцсетей. Чтобы выключить блокировку на одном сайте, воспользуйтесь меню страницы."
          }
        }
      }
    },
    "App Icon" : {
      "localizations" : {
