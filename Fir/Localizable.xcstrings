    "Pages you open here aren't saved, and their cookies and site data are gone when you close the last private tab." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открытые здесь страницы не сохраняются, а их cookie и данные сайтов исчезают, когда закрывается последняя частная вкладка."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pagine che apri qui non vengono salvate e i loro cookie e dati dei siti vengono eliminati quando chiudi l'ultimo pannello privato."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las páginas que abras aquí no se guardan, y sus cookies y datos de sitios desaparecen al cerrar la última pestaña privada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As páginas que você abre aqui não são salvas, e os cookies e dados de sites delas somem quando você fecha a última aba privada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier geöffnete Seiten werden nicht gesichert, und ihre Cookies und Websitedaten verschwinden, wenn Sie den letzten privaten Tab schließen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages que vous ouvrez ici ne sont pas enregistrées, et leurs cookies et données de site disparaissent à la fermeture du dernier onglet privé."
          }
        }
      }
    },
