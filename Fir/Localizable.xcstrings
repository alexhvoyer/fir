    "Search right away, or a start page with your pinned and frequent sites and history." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сразу поиск или стартовая страница с закреплёнными и частыми сайтами и историей."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca subito, oppure apri una pagina iniziale con i siti fissati e frequenti e la cronologia."
          }
        },
        "es" : {
