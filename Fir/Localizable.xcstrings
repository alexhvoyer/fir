    "General lists miss many ads on sites in other languages. Turn on the lists for the languages you read." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общие списки пропускают много рекламы на сайтах на других языках. Включите списки для языков, на которых вы читаете."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elenchi generali non bloccano molti annunci sui siti in altre lingue. Attiva gli elenchi per le lingue che leggi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las listas generales no detectan muchos anuncios en sitios en otros idiomas. Activa las listas de los idiomas que lees."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As listas gerais deixam passar muitos anúncios em sites de outros idiomas. Ative as listas dos idiomas que você lê."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allgemeine Listen übersehen viel Werbung auf Websites in anderen Sprachen. Aktivieren Sie die Listen für die Sprachen, die Sie lesen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les listes générales laissent passer de nombreuses publicités sur les sites en d’autres langues. Activez les listes des langues que vous lisez."
          }
        }
      }
    },
