    "\"%@\" will be able to read and change %@ and %lld more." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@\" will be able to read and change %2$@ and %3$lld more."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» сможет читать и изменять %2$@ и ещё %3$lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” potrà leggere e modificare %2$@ e altri %3$lld siti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” podrá leer y cambiar %2$@ y %3$lld más."
