    "New Tab puts + in its place. Swipe up on the address bar for your tabs, or touch and hold + for the tab menu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Neuer Tab“ setzt + an seine Stelle. Wische auf der Adressleiste nach oben für deine Tabs oder halte + gedrückt für das Tab-Menü."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nueva pestaña pone + en su lugar. Desliza hacia arriba en la barra de direcciones para ver tus pestañas o mantén pulsado + para el menú de pestañas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouvel onglet le remplace par +. Balayez vers le haut sur la barre d’adresse pour vos onglets, ou maintenez + pour le menu des onglets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuovo pannello mette + al suo posto. Scorri verso l’alto sulla barra degli indirizzi per i pannelli, o tieni premuto + per il menu dei pannelli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nova Aba coloca + no lugar. Deslize para cima na barra de endereço para ver as abas, ou toque e segure + para o menu de abas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Новая вкладка» ставит на её место +. Смахните вверх по адресной строке, чтобы увидеть вкладки, или удерживайте +, чтобы открыть меню вкладок."
          }
        }
      }
    },
