    "It syncs to Zen." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он синхронизируется с Zen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sincronizza con Zen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sincroniza con Zen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela é sincronizada com o Zen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wird mit Zen synchronisiert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisé avec Zen."
          }
        }
      }
    },
    "It will also see the addresses of your open tabs." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оно также будет видеть адреса открытых вкладок."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedrà anche gli indirizzi dei pannelli aperti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También verá las direcciones de tus pestañas abiertas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela também verá os endereços das suas abas abertas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Außerdem sieht es die Adressen Ihrer offenen Tabs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il verra aussi les adresses de vos onglets ouverts."
          }
        }
      }
    },
    "Its cookies and data on this iPhone are removed, so you're signed out of it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его cookie и данные на этом iPhone удалятся, и вы выйдете из аккаунта на нём."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi cookie e dati su questo iPhone vengono rimossi, quindi uscirai dal sito."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus cookies y datos en este iPhone se eliminan, así que se cerrará tu sesión en él."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cookies e dados dele neste iPhone são removidos, e sua sessão nele é encerrada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies und Daten dieser Website auf diesem iPhone werden entfernt, Sie werden dort also abgemeldet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses cookies et ses données sur cet iPhone sont supprimés, vous en êtes donc déconnecté."
          }
        }
      }
    },
    "Its tabs close in Zen on your computers too. Ones open here stay, outside the folder." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Её вкладки закроются и в Zen на ваших компьютерах. Открытые здесь останутся, но вне папки."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi pannelli si chiudono anche in Zen sui tuoi computer. Quelli aperti qui restano, fuori dalla cartella."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus pestañas también se cierran en Zen en tus ordenadores. Las que estén abiertas aquí se quedan, fuera de la carpeta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As abas dela também são fechadas no Zen dos seus computadores. As que estão abertas aqui permanecem, fora da pasta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tabs darin werden auch in Zen auf Ihren Computern geschlossen. Hier geöffnete Tabs bleiben, aber außerhalb des Ordners."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses onglets se ferment aussi dans Zen sur vos ordinateurs. Ceux ouverts ici restent, hors du dossier."
          }
        }
      }
    },
    "Its tabs close." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Её вкладки закроются."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi pannelli verranno chiusi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus pestañas se cierran."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As abas dela são fechadas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tabs darin werden geschlossen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses onglets se ferment."
          }
        }
      }
    },
