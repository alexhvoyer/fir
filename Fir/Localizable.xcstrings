    "See a workspace's tabs side by side: choose Grid in Settings > Tabs > Tab Overview. Swipe a tab left to close it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкладки пространства рядом друг с другом: выберите «Сетка» в «Настройки» > «Вкладки» > «Обзор вкладок». Чтобы закрыть вкладку, смахните её влево."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi affiancati i pannelli di uno spazio di lavoro: scegli Griglia in Impostazioni > Pannelli > Panoramica pannelli. Scorri un pannello a sinistra per chiuderlo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve las pestañas de un espacio de trabajo una al lado de otra: elige Cuadrícula en Ajustes > Pestañas > Vista de pestañas. Desliza una pestaña a la izquierda para cerrarla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja as abas de um espaço de trabalho lado a lado: escolha Grade em Ajustes > Abas > Visão Geral das Abas. Deslize uma aba para a esquerda para fechá-la."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabs eines Arbeitsbereichs nebeneinander sehen: Wählen Sie „Raster“ unter „Einstellungen“ > „Tabs“ > „Tab-Übersicht“. Wischen Sie einen Tab nach links, um ihn zu schließen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez les onglets d’un espace de travail côte à côte : choisissez Grille dans Réglages > Onglets > Aperçu des onglets. Balayez un onglet vers la gauche pour le fermer."
          }
        }
      }
    },
