    "The model couldn't read the pages: %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модели не удалось прочитать страницы: %@"
          }
        }
      }
    },
    "The page may already be in your language, or its language isn't available for translation." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, страница уже на вашем языке или её язык недоступен для перевода."
          }
        }
      }
    },
    "Theme" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тема"
          }
        }
      }
    },
    "These are your Zen workspaces. Changes here reach Zen on your computers too." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это ваши пространства Zen. Изменения здесь попадут и в Zen на ваших компьютерах."
          }
        }
      }
    },
    "This add-on" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это дополнение"
          }
        }
      }
    },
    "This form will be sent over an insecure connection. Anything in it could be seen by others on the network." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта форма будет отправлена по незащищённому соединению. Её содержимое могут увидеть другие в сети."
          }
        }
      }
    },
    "This page has no article to show on its own." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этой странице нет статьи, которую можно показать отдельно."
          }
        }
      }
    },
    "This page is already in the language it would be translated into." : {
