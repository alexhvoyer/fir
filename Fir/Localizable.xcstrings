    "How Zen and your other devices list this iPhone, as in Send Tab to Device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So zeigen Zen und deine anderen Geräte dieses iPhone an, etwa unter „Tab an Gerät senden“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así ven Zen y tus otros dispositivos este iPhone, como en «Enviar pestaña a dispositivo»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom de cet iPhone dans Zen et vos autres appareils, comme dans « Envoyer l’onglet à un appareil »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome di questo iPhone in Zen e sugli altri dispositivi, come in «Invia scheda a dispositivo»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como o Zen e seus outros dispositivos mostram este iPhone, como em “Enviar aba para dispositivo”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так Zen и другие ваши устройства показывают этот iPhone, например в «Отправить вкладку на устройство»."
          }
        }
      }
    },
    "In iOS Settings, choose Fir under Apps > Default Apps > Browser App. Links from other apps then open here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie in den iOS-Einstellungen unter „Apps“ > „Standard-Apps“ > „Browser-App“ Fir aus. Links aus anderen Apps werden dann hier geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Ajustes de iOS, elige Fir en Apps > Apps por omisión > App de navegador. Así, los enlaces de otras apps se abrirán aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les Réglages iOS, choisissez Fir sous Apps > Apps par défaut > Navigateur. Les liens provenant d’autres apps s’ouvriront alors ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Impostazioni di iOS, scegli Fir in App > App predefinite > App browser. I link dalle altre app si apriranno qui."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos Ajustes do iOS, escolha o Fir em Apps > Apps Padrão > Navegador. Assim, os links de outros apps abrem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В настройках iOS выберите Fir в разделе «Приложения» > «Приложения по умолчанию» > «Браузер». Тогда ссылки из других приложений будут открываться здесь."
          }
        }
      }
    },
