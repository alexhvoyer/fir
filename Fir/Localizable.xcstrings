    "Suggestions send what you type to the search engine." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для подсказок введённый текст отправляется в поисковую систему."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suggerimenti inviano al motore di ricerca ciò che digiti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sugerencias envían lo que escribes al buscador."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sugestões enviam o que você digita ao buscador."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Vorschläge wird Ihre Eingabe an die Suchmaschine gesendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les suggestions envoient votre saisie au moteur de recherche."
          }
        }
      }
    },
    "Suggestions send what you type to the search engine. History matches stay on this device." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для подсказок введённый текст отправляется в поисковую систему. Совпадения из истории остаются на этом устройстве."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suggerimenti inviano al motore di ricerca ciò che digiti. Le corrispondenze nella cronologia restano su questo dispositivo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sugerencias envían lo que escribes al buscador. Las coincidencias del historial se quedan en este dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sugestões enviam o que você digita ao buscador. As correspondências do histórico ficam neste dispositivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Vorschläge wird Ihre Eingabe an die Suchmaschine gesendet. Treffer aus dem Verlauf bleiben auf diesem Gerät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les suggestions envoient votre saisie au moteur de recherche. Les correspondances de l’historique restent sur cet appareil."
          }
        }
      }
    },
