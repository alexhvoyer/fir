    "Adds protection against malicious websites. Heavy sites run slower in private tabs. Applies from the next page load." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет защиту от вредоносных сайтов. Тяжёлые сайты в частных вкладках работают медленнее. Действует со следующей загрузки страницы."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge protezione contro i siti web dannosi. I siti pesanti sono più lenti nei pannelli privati. Si applica dal prossimo caricamento di una pagina."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade protección contra sitios web maliciosos. Los sitios pesados van más lentos en las pestañas privadas. Se aplica a partir de la próxima carga de página."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona proteção contra sites maliciosos. Sites pesados ficam mais lentos em abas privadas. Vale a partir do próximo carregamento de página."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bietet zusätzlichen Schutz vor schädlichen Websites. Aufwendige Websites laufen in privaten Tabs langsamer. Gilt ab dem nächsten Laden einer Seite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renforce la protection contre les sites malveillants. Les sites lourds sont plus lents dans les onglets privés. S’applique au prochain chargement de page."
          }
        }
      }
    },
