    "Your connection to %@ is encrypted, but some of this page's content isn't." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединение с %@ зашифровано, но часть содержимого страницы — нет."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione a %@ è crittografata, ma parte del contenuto di questa pagina non lo è."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu conexión con %@ está cifrada, pero parte del contenido de esta página no lo está."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conexão com %@ é criptografada, mas parte do conteúdo desta página não é."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Verbindung zu %@ ist verschlüsselt, aber ein Teil des Seiteninhalts nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre connexion à %@ est chiffrée, mais une partie du contenu de cette page ne l’est pas."
          }
        }
      }
    },
    "Your connection to %@ is encrypted. What you send stays private on the way there." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединение с %@ зашифровано. То, что вы отправляете, по пути никто не увидит."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione a %@ è crittografata. Ciò che invii resta privato durante il percorso."
          }
        },
        "es" : {
