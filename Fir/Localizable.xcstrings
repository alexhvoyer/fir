    "With Reduce Motion on in iOS Settings, sheets slide up without the zoom and pages switch to your tabs at once." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если в настройках iOS включено «Уменьшение движения», шторки выезжают без увеличения, а страницы сразу переключаются к вкладкам."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Riduci movimento attivo in Impostazioni di iOS, i riquadri scorrono verso l'alto senza zoom e le pagine passano subito ai pannelli."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Reducir movimiento activado en Ajustes de iOS, las hojas aparecen sin zoom y las páginas pasan a tus pestañas al instante."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com Reduzir Movimento ativado nos Ajustes do iOS, os painéis sobem sem o zoom e as páginas passam para as abas na hora."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist in den iOS-Einstellungen „Bewegung reduzieren“ aktiviert, gleiten Fenster ohne Zoom nach oben und Seiten wechseln sofort zu Ihren Tabs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Réduire les animations activé dans les Réglages iOS, les volets glissent vers le haut sans zoom et les pages basculent immédiatement vers vos onglets."
          }
        }
      }
    },
    "With history sync on, this can also clear it in Zen." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если история синхронизируется, она может очиститься и в Zen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la sincronizzazione della cronologia attiva, può cancellarla anche in Zen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la sincronización del historial activada, también puede borrarlo en Zen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a sincronização do histórico ativada, isso também pode limpá-lo no Zen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist die Verlaufssynchronisierung aktiv, kann dies den Verlauf auch in Zen löschen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la synchronisation de l’historique est activée, il peut aussi être effacé dans Zen."
          }
        }
      }
    },
