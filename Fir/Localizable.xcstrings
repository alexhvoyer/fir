    "Passwords, history and bookmarks are removed from this iPhone. What has synced stays in your Mozilla account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwörter, Verlauf und Lesezeichen werden von diesem iPhone entfernt. Bereits Synchronisiertes bleibt in Ihrem Mozilla-Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las contraseñas, el historial y los marcadores se eliminan de este iPhone. Lo que se ha sincronizado se queda en tu cuenta de Mozilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots de passe, l’historique et les marque-pages sont supprimés de cet iPhone. Ce qui a été synchronisé reste dans votre compte Mozilla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Password, cronologia e segnalibri vengono rimossi da questo iPhone. Ciò che è stato sincronizzato resta nel tuo account Mozilla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As senhas, o histórico e os favoritos são removidos deste iPhone. O que já foi sincronizado fica na sua conta Mozilla."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароли, история и закладки удалятся с этого iPhone. Всё, что уже синхронизировано, останется в аккаунте Mozilla."
          }
        }
      }
    },
