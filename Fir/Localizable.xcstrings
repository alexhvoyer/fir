    "Zen asks you to confirm on your computer, then closes the workspace's tabs there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zen bittet Sie, auf Ihrem Computer zu bestätigen, und schließt dann dort die Tabs des Arbeitsbereichs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zen te pide que lo confirmes en tu ordenador y después cierra allí las pestañas del espacio de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zen vous demande de confirmer sur votre ordinateur, puis y ferme les onglets de l’espace de travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zen ti chiede di confermare sul computer, poi chiude lì i pannelli dello spazio di lavoro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zen pede confirmação no seu computador e então fecha lá as abas desse espaço de trabalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zen попросит подтвердить на компьютере, а затем закроет там вкладки этого пространства."
          }
        }
      }
    },
