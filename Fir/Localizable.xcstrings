    "Passwords and history are removed from this iPhone. What has synced stays in your Mozilla account." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароли и история удалятся с этого iPhone. Всё, что уже синхронизировано, останется в аккаунте Mozilla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Password e cronologia vengono rimosse da questo iPhone. Ciò che è stato sincronizzato resta nel tuo account Mozilla."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las contraseñas y el historial se eliminan de este iPhone. Lo que se ha sincronizado se queda en tu cuenta de Mozilla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As senhas e o histórico são removidos deste iPhone. O que já foi sincronizado fica na sua conta Mozilla."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwörter und Verlauf werden von diesem iPhone entfernt. Bereits Synchronisiertes bleibt in Ihrem Mozilla-Konto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots de passe et l’historique sont supprimés de cet iPhone. Ce qui a été synchronisé reste dans votre compte Mozilla."
          }
        }
      }
    },
