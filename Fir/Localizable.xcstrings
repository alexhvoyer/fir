        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” poderá ler e alterar %2$@ e mais %3$lld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ kann %2$@ und %3$lld weitere Websites lesen und ändern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
