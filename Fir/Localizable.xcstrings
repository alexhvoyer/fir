    "Up to three. While Back and Forward are shown, only the last one stays, to leave room for the address." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До трёх. Пока показаны кнопки «Назад» и «Вперёд», остаётся только последняя, чтобы хватило места для адреса."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino a tre. Quando sono visibili Indietro e Avanti, resta solo l'ultimo, per lasciare spazio all'indirizzo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta tres. Mientras se muestran Atrás y Adelante, solo se queda el último, para dejar sitio a la dirección."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até três. Enquanto Voltar e Avançar estiverem visíveis, só o último fica, para sobrar espaço para o endereço."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu drei. Solange „Zurück“ und „Vorwärts“ angezeigt werden, bleibt nur die letzte, damit Platz für die Adresse bleibt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’à trois. Quand Retour et Suivant sont affichés, seul le dernier reste, pour laisser de la place à l’adresse."
          }
        }
      }
    },
