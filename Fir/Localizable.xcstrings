    },
    "Fir closed before this list was ready, so it was turned off. Turn it on to try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir wurde beendet, bevor diese Liste fertig war, daher wurde sie ausgeschaltet. Schalte sie ein, um es erneut zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir se cerró antes de que esta lista estuviera lista, así que se ha desactivado. Actívala para volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir s'est fermé avant que cette liste soit prête, elle a donc été désactivée. Activez-la pour réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir si è chiuso prima che questo elenco fosse pronto, quindi è stato disattivato. Attivalo per riprovare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fir fechou antes de esta lista ficar pronta, então ela foi desativada. Ative-a para tentar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir закрылся до того, как список был готов, поэтому он выключен. Включите его, чтобы попробовать снова."
          }
        }
      }
    },
    "Fir couldn't read the results. If the search asks you to prove you're human, answer it there and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir konnte die Ergebnisse nicht lesen. Falls die Suche eine Bestätigung verlangt, dass Sie ein Mensch sind, erledigen Sie das dort und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir no ha podido leer los resultados. Si el buscador te pide demostrar que eres humano, respóndelo allí e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir n’a pas pu lire les résultats. Si le moteur de recherche vous demande de prouver que vous êtes humain, répondez-y puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir non è riuscito a leggere i risultati. Se la ricerca ti chiede di dimostrare che sei una persona, rispondi lì e riprova."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fir não conseguiu ler os resultados. Se a busca pedir para você provar que é humano, responda lá e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir не удалось прочитать результаты. Если поисковик просит подтвердить, что вы человек, ответьте там и попробуйте снова."
          }
        }
      }
    },
