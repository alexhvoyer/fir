    "Type a keyword and a space in the address bar, like “%@”, to search with that engine." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie in der Adressleiste ein Schlüsselwort und ein Leerzeichen ein, etwa „%@“, um mit dieser Suchmaschine zu suchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe una palabra clave y un espacio en la barra de direcciones, como «%@», para buscar con ese buscador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapez un mot-clé et une espace dans la barre d’adresse, par exemple « %@ », pour chercher avec ce moteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi una parola chiave e uno spazio nella barra degli indirizzi, ad esempio «%@», per cercare con quel motore."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite uma palavra-chave e um espaço na barra de endereço, como “%@”, para buscar com esse buscador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите ключевое слово и пробел в адресной строке, например «%@», чтобы искать в этой поисковой системе."
          }
        }
      }
    },
