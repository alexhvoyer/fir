    "No pinned tabs or folders in this space. Tabs you open here stay in it, on this iPhone only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine angehefteten Tabs oder Ordner in diesem Arbeitsbereich. Tabs, die Sie hier öffnen, bleiben darin, nur auf diesem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay pestañas fijadas ni carpetas en este espacio. Las pestañas que abras aquí se quedan en él, solo en este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun onglet épinglé ni dossier dans cet espace. Les onglets que vous ouvrez ici y restent, sur cet iPhone uniquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun pannello fissato o cartella in questo spazio. I pannelli che apri qui restano in questo spazio, solo su questo iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma aba ou pasta fixada neste espaço. As abas que você abrir aqui ficam nele, somente neste iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом пространстве нет закреплённых вкладок и папок. Вкладки, открытые здесь, остаются в нём, только на этом iPhone."
          }
        }
      }
    },
    "No saved passwords yet. Passwords saved in Zen appear here after sync." : {
