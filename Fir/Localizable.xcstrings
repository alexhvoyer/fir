    "Experimental" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспериментальные"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperimentale"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimental"
          }
        },
        "pt-BR" : {
