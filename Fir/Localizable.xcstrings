    "Fir opens ready to type. The page you were reading stays behind the search." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir открывается сразу с полем ввода. Страница, которую вы читали, остаётся под поиском."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir si apre pronto per scrivere. La pagina che stavi leggendo resta dietro la ricerca."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir se abre listo para escribir. La página que leías queda detrás de la búsqueda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fir abre pronto para digitar. A página que você estava lendo fica atrás da busca."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir öffnet sich direkt zur Eingabe. Die Seite, die Sie gelesen haben, bleibt hinter der Suche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir s’ouvre prêt pour la saisie. La page que vous lisiez reste derrière la recherche."
          }
        }
      }
    },
    "Fir shows a short list of changes after a major update. It stays in Settings under About." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После крупного обновления Fir показывает короткий список изменений. Он остаётся в настройках в разделе «О программе»."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir mostra un breve elenco delle novità dopo un aggiornamento importante. Resta disponibile in Impostazioni, sotto Info."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir muestra una breve lista de cambios tras una actualización importante. Sigue disponible en Ajustes, en Información."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fir mostra uma lista curta de mudanças após uma grande atualização. Ela fica nos Ajustes, em Sobre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einem großen Update zeigt Fir eine kurze Liste der Änderungen. Sie bleibt in den Einstellungen unter „Info“ verfügbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fir affiche une courte liste des nouveautés après une mise à jour majeure. Elle reste disponible dans Réglages, sous À propos."
          }
        }
      }
