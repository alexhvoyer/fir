    "Cards shows one tab at a time to swipe through. Grid shows a workspace's tabs side by side." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Karten“ zeigt einen Tab nach dem anderen zum Durchwischen. „Raster“ zeigt die Tabs eines Arbeitsbereichs nebeneinander."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarjetas muestra una pestaña cada vez para pasarlas con el dedo. Cuadrícula muestra las pestañas de un espacio de trabajo una al lado de otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartes affiche un onglet à la fois, à faire défiler d’un geste. Grille affiche les onglets d’un espace de travail côte à côte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schede mostra un pannello alla volta da scorrere. Griglia mostra affiancati i pannelli di uno spazio di lavoro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartões mostra uma aba por vez para deslizar. Grade mostra as abas de um espaço de trabalho lado a lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карточки показывают по одной вкладке, их листают свайпом. Сетка показывает вкладки пространства рядом друг с другом."
          }
        }
      }
    },
    "Cards to swipe through one at a time, or a grid that shows them side by side." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karten, die Sie einzeln durchwischen, oder ein Raster mit allen Tabs nebeneinander."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarjetas que se pasan de una en una, o una cuadrícula que las muestra una al lado de otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des cartes à faire défiler une par une, ou une grille qui les affiche côte à côte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schede da scorrere una alla volta o una griglia che le mostra affiancate."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartões para deslizar um por vez ou uma grade que mostra as abas lado a lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карточки, которые листаются по одной, или сетка, где вкладки видны рядом."
          }
        }
      }
    },
