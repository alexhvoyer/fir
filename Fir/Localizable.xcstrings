    "Sign in with the Mozilla account from Zen or Firefox. Workspaces, tabs, history and passwords come along." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите в аккаунт Mozilla, которым пользуетесь в Zen или Firefox. Пространства, вкладки, история и пароли появятся здесь."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con l'account Mozilla di Zen o Firefox. Spazi di lavoro, pannelli, cronologia e password ti seguono."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con la cuenta de Mozilla de Zen o Firefox. Tus espacios de trabajo, pestañas, historial y contraseñas te acompañan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sessão com a conta Mozilla do Zen ou do Firefox. Espaços de trabalho, abas, histórico e senhas vêm junto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich mit dem Mozilla-Konto aus Zen oder Firefox an. Arbeitsbereiche, Tabs, Verlauf und Passwörter kommen mit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec le compte Mozilla de Zen ou Firefox. Espaces de travail, onglets, historique et mots de passe vous suivent."
          }
        }
      }
    },
    "Sign in with the account you use in Zen to get its tabs, history and workspaces here." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите в аккаунт, которым пользуетесь в Zen, чтобы получить здесь его вкладки, историю и пространства."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con l'account che usi in Zen per avere qui i suoi pannelli, la cronologia e gli spazi di lavoro."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con la cuenta que usas en Zen para tener aquí sus pestañas, historial y espacios de trabajo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sessão com a conta que você usa no Zen para trazer as abas, o histórico e os espaços de trabalho para cá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich mit dem Konto an, das Sie in Zen verwenden, um dessen Tabs, Verlauf und Arbeitsbereiche hierher zu holen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec le compte que vous utilisez dans Zen pour retrouver ici ses onglets, son historique et ses espaces de travail."
          }
        }
      }
    },
    "Sign in with your Mozilla account to see your workspaces, pinned sites, open tabs and history from Zen." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите в аккаунт Mozilla, чтобы видеть пространства, закреплённые сайты, открытые вкладки и историю из Zen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con il tuo account Mozilla per vedere spazi di lavoro, siti fissati, pannelli aperti e cronologia di Zen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con tu cuenta de Mozilla para ver tus espacios de trabajo, sitios fijados, pestañas abiertas e historial de Zen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sessão com sua conta Mozilla para ver os espaços de trabalho, sites fixados, abas abertas e histórico do Zen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich mit Ihrem Mozilla-Konto an, um Ihre Arbeitsbereiche, angehefteten Websites, offenen Tabs und den Verlauf aus Zen zu sehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec votre compte Mozilla pour voir vos espaces de travail, sites épinglés, onglets ouverts et historique de Zen."
          }
        }
      }
    },
