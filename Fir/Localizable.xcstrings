          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Espacios de trabajo de Zen en Sincronización para verlos y editarlos aquí."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
