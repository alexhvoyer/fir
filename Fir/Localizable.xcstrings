    "Search Sheet" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шторка поиска"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riquadro di ricerca"
          }
        },
        "es" : {
          "stringUnit" : {
